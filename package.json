{
  "name": "@216digital/ui",
  "version": "0.3.0",
  "description": "The 216digital design system: hand-written React components, design tokens and component CSS.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobby-216digital/216-ui.git"
  },
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "playground": "next dev playground",
    "playground:build": "next build playground",
    "check-pack": "node scripts/check-pack.mjs",
    "check-palette": "node scripts/check-palette.mjs"
  },
  "peerDependencies": {
    "next": ">=16.3 <17",
    "react": "^19.2",
    "react-dom": "^19.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
